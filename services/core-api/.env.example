APP_NAME=Core API
APP_ENV=development
APP_LOG_LEVEL=INFO
# Set to a JSON array of allowed frontend origins; leave empty to disable CORS.
APP_CORS_ORIGINS=[]
APP_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ats_platform
# Redis connection used by the worker. In production, replace with the managed Redis URL.
APP_REDIS_URL=redis://localhost:6379/0
# Optional independent overrides. By default Celery uses Redis DB 0 for broker and DB 1 for results.
# APP_CELERY_BROKER_URL=redis://localhost:6379/0
# APP_CELERY_RESULT_BACKEND=redis://localhost:6379/1
# Local development runs tasks in-process by default, so Redis is not required. Set true to use the broker.
# APP_CELERY_TASK_ALWAYS_EAGER=false


# AI service used by the resume parsing pipeline. The key must match AI_SERVICE_API_KEY in services/ai-service/.env.
APP_AI_SERVICE_URL=http://localhost:8001
APP_AI_SERVICE_API_KEY=replace-with-the-ai-service-api-key
# APP_AI_SERVICE_TIMEOUT_SECONDS=90

# Resume upload limits and storage (uploaded resumes contain personal data; keep this directory private).
# APP_RESUME_STORAGE_DIR=./storage/resumes
# APP_RESUME_MAX_UPLOAD_MB=10
# APP_RESUME_MAX_BATCH_FILES=50
# APP_RESUME_MAX_PDF_PAGES=50
# APP_RESUME_MAX_TEXT_CHARS=100000
# APP_RESUME_PARSE_MAX_RETRIES=3