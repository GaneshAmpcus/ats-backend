APP_NAME=ATS AI Service
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ats
DATABASE_ECHO=false
AI_DATABASE_SCHEMA=ai_service

# Required for every HTTP endpoint. Use a long, random value and keep it secret.
AI_SERVICE_API_KEY=replace-with-a-long-random-secret

EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_NORMALIZE=true
EMBEDDING_BATCH_SIZE=32

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.0
GROQ_MAX_TOKENS=8192
GROQ_TIMEOUT_SECONDS=60
